FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps ./apps
COPY scripts ./scripts
RUN npm ci
ARG APP=player-web
ARG VITE_API_URL
ARG VITE_WS_URL
ARG VITE_PLAYER_WEB_URL
ENV VITE_API_URL=$VITE_API_URL VITE_WS_URL=$VITE_WS_URL VITE_PLAYER_WEB_URL=$VITE_PLAYER_WEB_URL
RUN npm run build --workspace @syncup/$APP
RUN mkdir /out && cp -r apps/$APP/dist/. /out/

FROM nginx:1.27-alpine
COPY --from=builder /out /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
